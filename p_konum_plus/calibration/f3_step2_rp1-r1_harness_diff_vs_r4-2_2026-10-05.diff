+# ---------------- C-3/C-4 tests: synthetic raw files only (S-e) -------------
+def _synth_raw_write(d, rows_by_year):
+    os.makedirs(d, exist_ok=True)
+    for y, rows in rows_by_year.items():
+        with open(os.path.join(d, "yob%d.txt" % y), "w", encoding="ascii",
+                  newline="\n") as f:
+            for r in rows:
+                f.write("%s,%s,%d\n" % r)
+
